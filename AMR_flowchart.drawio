        <mxCell id="a4_e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="a4_m7" target="a4_q3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4_e12" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="a4_q3" target="a4_e1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4_e13" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="a4_q3" target="a4_m8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4_e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="a4_m8" target="a4_e0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4_note" value="프로그램이 켜질 때 한 번만 실행한다. 지도를 미리 걸러서 Nav2 에 보내도 되는 좌표를 정해둔다.&lt;br&gt;A↔B 왕복 순찰은 amr_ab_controller_patrol.py 로 분리됐다. 지금 컨트롤러에서 A 는 회전 탐색 지점이고, B 는 주행 목표가 아니라 안전하다고 인정할 영역을 정하는 기준점으로만 쓰인다.&lt;br&gt;접근 목표는 기본적으로 지도 전체를 대상으로 검사한다 (restrict_to_corridor = false). 어느 경우든 여유 0.35 m 와 B 와의 연결을 확인한다.&lt;br&gt;ROS 의 /robot3/map 토픽을 구독하지 않는다. 로컬 minimap.pgm 파일을 직접 읽으므로 Nav2 가 쓰는 지도와 같은 파일이어야 좌표가 맞는다.&lt;br&gt;목표 지점만 미리 검사하는 것이지 Nav2 의 통행 금지 구역 설정이 아니다. 계획된 경로 전체가 통로 안에 머문다는 보장은 없다." style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;size=14;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="864" width="1040" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="5. 노드 · 토픽 명세" id="a5">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="a5_b0" value="&lt;b&gt;노드 : webcam_event    (PC)&lt;/b&gt;&lt;br&gt;&lt;br&gt;파일 : webcam_event.py        네임스페이스 : /robot3&lt;br&gt;&lt;br&gt;[ 입력 ]&lt;br&gt;  /dev/video0  MJPG 640x480  (ROS 아님)&lt;br&gt;  sub  /robot3/amr/status            std_msgs/String&lt;br&gt;&lt;br&gt;[ 출력 ]&lt;br&gt;  pub  /robot3/amr/event             std_msgs/String&lt;br&gt;       &quot;START&quot; / &quot;STOP&quot; / &quot;RESET&quot;&lt;br&gt;  pub  /robot3/amr/webcam_view/compressed   (5 Hz)&lt;br&gt;&lt;br&gt;[ 모델 ]  models/webcam_car_dummy_aug.pt&lt;br&gt;  클래스 : car , dummy     신뢰도 0.7 · 연속 5프레임&lt;br&gt;  car 만 집계 · 재발행 간격 30초&lt;br&gt;  로봇이 IDLE 일 때만 START 를 보낸다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="460" height="330" as="geometry" />
        </mxCell>
        <mxCell id="a5_b1" value="&lt;b&gt;노드 : amr_ab_controller    (PC)&lt;/b&gt;&lt;br&gt;&lt;br&gt;파일 : amr_ab_controller.py + approach_core.py + paths.py&lt;br&gt;네임스페이스 : /robot3      TF 바꿔 잇기 : /tf → /robot3/tf&lt;br&gt;&lt;br&gt;[ 구독 ]&lt;br&gt;  /robot3/amr/event                  std_msgs/String&lt;br&gt;  /robot3/dock_status                irobot_create_msgs/DockStatus&lt;br&gt;  /robot3/amcl_pose                  PoseWithCovarianceStamped&lt;br&gt;  /robot3/clicked_point              geometry_msgs/PointStamped&lt;br&gt;                                     (RViz Publish Point → 탐색 지점 변경)&lt;br&gt;  /robot3/oakd/rgb/image_raw/compressed         CompressedImage&lt;br&gt;  /robot3/oakd/stereo/image_raw/compressedDepth CompressedImage&lt;br&gt;  /robot3/oakd/rgb/camera_info                  CameraInfo&lt;br&gt;  /robot3/tf , /robot3/tf_static                tf2_msgs/TFMessage&lt;br&gt;&lt;br&gt;[ 발행 ]&lt;br&gt;  /robot3/initialpose                PoseWithCovarianceStamped&lt;br&gt;  /robot3/amr/status                 std_msgs/String  (1 Hz)&lt;br&gt;  /robot3/amr/target_info            std_msgs/String  (JSON)&lt;br&gt;  /robot3/amr/camera_view/compressed CompressedImage&lt;br&gt;  /robot3/cmd_vel                    geometry_msgs/TwistStamped&lt;br&gt;                                     (제자리 회전 · Nav2 를 거치지 않음)&lt;br&gt;&lt;br&gt;[ 액션 ]&lt;br&gt;  /robot3/undock            irobot_create_msgs/action/Undock&lt;br&gt;  /robot3/navigate_to_pose  nav2_msgs/action/NavigateToPose&lt;br&gt;&lt;br&gt;[ 상태 흐름 ]&lt;br&gt;  IDLE → WAIT_DOCK_STATUS → UNDOCKING → LOCALIZING&lt;br&gt;  → SEARCH → NAV_SEARCH → SCAN → APPROACH → HOLD&lt;br&gt;  (STOPPED · FAULT 는 어느 상태에서든 들어간다)&lt;br&gt;&lt;br&gt;[ 로컬 파일 ]  maps/minimap.{yaml,pgm} · models/oakd_best1.pt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="60" width="640" height="660" as="geometry" />
        </mxCell>
        <mxCell id="a5_b2" value="&lt;b&gt;노드 : turtle_cam_view    (PC)&lt;/b&gt;&lt;br&gt;&lt;br&gt;파일 : turtle_cam_view.py       네임스페이스 : /robot3&lt;br&gt;&lt;br&gt;[ 구독 ]  /robot3/amr/camera_view/compressed&lt;br&gt;&lt;br&gt;컨트롤러가 이미 받은 영상을 다시 쓰므로&lt;br&gt;무선 통신을 추가로 쓰지 않는다.&lt;br&gt;컨트롤러가 켜져 있어야 화면이 나온다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="460" height="190" as="geometry" />
        </mxCell>
        <mxCell id="a5_b3" value="&lt;b&gt;이 패키지가 띄우지 않는 것&lt;/b&gt;&lt;br&gt;&lt;br&gt;[ 로봇 robot3 / 라즈베리파이 ]&lt;br&gt;  oakd 드라이버 — RGB · 깊이 · camera_info&lt;br&gt;  Create3 — dock_status , undock 액션 , cmd_vel&lt;br&gt;&lt;br&gt;[ PC, 터미널마다 순서대로 ]&lt;br&gt;  ① localization.launch.py  map:=maps/minimap.yaml&lt;br&gt;  ② nav2.launch.py          → navigate_to_pose&lt;br&gt;  ③ view_navigation.launch.py → RViz (2D Pose Estimate)&lt;br&gt;  ④ amr_ab_controller --execute&lt;br&gt;&lt;br&gt;  전부 namespace:=/robot3 로 띄워야 한다.&lt;br&gt;  --execute 를 빼면 연습 모드 (언독·주행 명령을 보내지 않음)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="460" height="290" as="geometry" />
        </mxCell>
        <mxCell id="a5_b4" value="&lt;b&gt;보조 도구 · 백업&lt;/b&gt;&lt;br&gt;&lt;br&gt;amr_ab_controller_patrol.py   A↔B 왕복 순찰 버전 (백업, git 태그 patrol-v1)&lt;br&gt;ab_nav_only.py                A → B 이동만 따로 시험 · 기본은 미리보기&lt;br&gt;bag_to_mp4.py                 녹화 파일 안의 영상 토픽을 mp4 로 변환&lt;br&gt;scripts/record_test.sh        ros2 bag record -s mcap&lt;br&gt;  amr/camera_view , amr/webcam_view , amr/status , amr/event ,&lt;br&gt;  amr/target_info , amcl_pose , tf , tf_static , map , plan ,&lt;br&gt;  cmd_vel , odom , scan , dock_status , battery_state , /rosout&lt;br&gt;test/test_approach_core.py    오프라인 단위 시험 11개&lt;br&gt;&lt;br&gt;[ 모델 3개 ]&lt;br&gt;  oakd_best1.pt             로봇 OAK-D 용 (기본값)&lt;br&gt;  webcam_car_dummy_aug.pt   웹캠 START 용 (기본값)&lt;br&gt;  nano_colab.pt             Colab 에서 학습한 nano · 웹캠용 후보" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="760" width="640" height="290" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
