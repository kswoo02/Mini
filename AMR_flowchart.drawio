        <mxCell id="a2_e22" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="a2_q8" target="a2_e0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2_note" value="dummy 는 두 번 걸러진다. ① 클래스 이름이 car 가 아니면 바로 탈락한다. ② car 로 잡혔더라도 dummy 상자와 30% 이상 겹치면 같은 물체를 두 클래스로 인식한 것으로 보고 포기한다.&lt;br&gt;버려진 상자도 화면에는 그려진다. car 와 dummy 를 전부 그리고 탈락 사유를 같이 적어 왜 접근하지 않는지 눈으로 확인할 수 있게 했다.&lt;br&gt;신뢰도 기준은 0.5 에서 0.7 로 올렸다. 진짜 car 는 0.88~0.96 으로 잡히고 오탐이 0.51 이었다.&lt;br&gt;ByteTrack 으로 같은 차에 같은 번호를 붙인다. 한 번 잠근 번호를 우선 따라가고, 번호가 끊기면 0.5 m 안의 상자로 다시 잇는다. 옆에 다른 차가 있어도 대상이 바뀌지 않게 하려는 장치다.&lt;br&gt;A 로 가는 동안 본 차는 기본적으로 무시한다 (detect_on_way = false)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;size=14;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="1070" width="1040" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3. 접근 · 추적" id="a3">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="a3_s0" value="대상 확정됨" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="60" width="230" height="96" as="geometry" />
        </mxCell>
        <mxCell id="a3_q1" value="마지막으로 본 지 1.5초 이내?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;target_timeout_s&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="46" width="230" height="124" as="geometry" />
        </mxCell>
        <mxCell id="a3_q2" value="로봇의 map 위치를 알 수 있나?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;/robot3/tf · map → base_link&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="46" width="230" height="124" as="geometry" />
        </mxCell>
        <mxCell id="a3_r1" value="차 앞 0.80 m 지점 계산&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;standoff_goal · standoff_m = 0.80&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1100" y="60" width="230" height="96" as="geometry" />
        </mxCell>
        <mxCell id="a3_q3" value="이미 0.80 m 안인가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1100" y="252" width="230" height="124" as="geometry" />
        </mxCell>
        <mxCell id="a3_q4" value="그 지점이 안전한가?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;MapGuard.safe_goal_anywhere&lt;br&gt;여유 0.35 m · B 와 이어짐&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="252" width="230" height="124" as="geometry" />
        </mxCell>
        <mxCell id="a3_r2" value="차 둘레로 대안 30개 탐색&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;find_approach_goal&lt;br&gt;반지름 1.0 / 1.25 / 1.5배 · 각도 ±15~±90도&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="266" width="230" height="96" as="geometry" />
        </mxCell>
        <mxCell id="a3_q5" value="통과하는 대안 있나?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="252" width="230" height="124" as="geometry" />
        </mxCell>
